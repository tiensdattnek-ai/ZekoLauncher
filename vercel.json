{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": false,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "includeFiles": [
    "client/**",
    "server/data/**",
    "docs/**",
    "README.md"
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
