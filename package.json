{
  "name": "zeko-launcher",
  "version": "1.0.0",
  "private": true,
  "description": "Zeko Launcher — launcher Minecraft thế hệ mới: giao diện đẹp, tối ưu FPS cho máy yếu và quét an toàn tệp game.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "scan": "node scripts/zeko-scan.js",
    "test": "node --test server/test/core.test.js",
    "test:ui": "node --test server/test/ui.smoke.test.js",
    "test:all": "node --test server/test/core.test.js server/test/ui.smoke.test.js",
    "bundle": "esbuild client/js/main.js --bundle --format=iife --outfile=client/assets/bundle.js --log-level=warning"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "performance",
    "fps",
    "security",
    "zeko"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^28.1.0"
  }
}
